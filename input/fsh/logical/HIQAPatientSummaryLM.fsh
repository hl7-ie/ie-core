Mapping: HIQAPatientSummaryLMToIECore
Source: HIQAPatientSummaryLM
Target: "https://hl7-ie.github.io/ie-core/fhir/ie/core"
Id: ie-core
Title: "IE Core profiles"
Description: "How each HIQA PS element is represented in IE Core. GAP = not represented."
* patientDetails.nameDetails.nameTitle -> "IECorePatientSummaryPatient: Patient.name.prefix" "Aligned"
* patientDetails.nameDetails.forename -> "IECorePatientSummaryPatient: Patient.name.given" "Aligned. given 1..*"
* patientDetails.nameDetails.middleNameS -> "IECorePatientSummaryPatient: Patient.name.given" "Aligned. second and later given names"
* patientDetails.nameDetails.surname -> "IECorePatientSummaryPatient: Patient.name.family" "Aligned. family 1..1"
